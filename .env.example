# Copy this file to .env and fill in your keys. Never commit the real .env file.

# https://aistudio.google.com/apikey  (free, no card required, generous free tier)
GEMINI_API_KEY=

# https://fal.ai/dashboard/keys  (free trial credit on signup, ~$10, then paid)
FAL_KEY=

# Which Kling endpoint to use. v1.6 standard is cheap enough that the free
# trial credit covers a full multi-beat video. Bump to a v2.6/pro endpoint
# for higher quality if you don't mind the credit going further per clip.
FAL_VIDEO_MODEL=fal-ai/kling-video/v1.6/standard/text-to-video

# Clip length per beat in seconds. Kling supports "5" or "10".
KLING_DURATION=5

# Optional: TTS voice for edge-tts. Run `edge-tts --list-voices` to see options.
TTS_VOICE=en-US-GuyNeural
